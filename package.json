{
  "name": "tree-sitter-ferrish",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Tree-sitter grammar for Ferrish.",
  "license": "MIT",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ferrish-lang/tree-sitter.git"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse:fixtures": "node scripts/parse-fixtures.mjs",
    "parse:fixtures:check": "node scripts/parse-fixtures.mjs --check",
    "test:fixtures:negative": "node scripts/check-fixture-failures.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:queries": "node scripts/check-queries.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "preverify": "npm run check:toolchain",
    "verify": "npm run check:generated && npm test && npm run parse:fixtures:check && npm run test:fixtures:negative && npm run check:queries"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.10"
  }
}
